@{
    ViewBag.Title = "Home";
    var loggedInRole = Session["LoggedInRole"] as string;
    var loggedInUser = Session["LoggedInUser"] as string;
}

<main>
    @if (string.IsNullOrWhiteSpace(loggedInRole))
    {
        <section class="dashboard-head dashboard-head-pro">
            <div>
                <p class="eyebrow">Home Overview</p>
                <h1>Welcome to Cozy Comfort</h1>
                <p class="text-muted mb-0">A professional blanket supply chain web app for Manufacturer, Distributor, and Seller operations.</p>
                <div class="hero-actions mt-3">
                    <a href="@Url.Action("Login", "Home")" class="btn btn-primary">Go to Login</a>
                </div>
            </div>
            <img class="dashboard-hero-image" src="@Url.Content("~/Content/images/cotton.svg")" alt="Cozy Comfort operations" />
        </section>
    }
    else if (loggedInRole == "Manufacturer")
    {
        <section class="dashboard-head manufacturer-head dashboard-head-pro">
            <div>
                <p class="eyebrow">Manufacturer Home</p>
                <h1>Welcome, @loggedInUser</h1>
                <p class="text-muted mb-0">Factory-level overview with production updates and inventory priorities.</p>
            </div>
            <img class="dashboard-hero-image" src="@Url.Content("~/Content/images/cotton.svg")" alt="Factory dashboard" />
        </section>

        <div class="row g-3 mb-3">
            <div class="col-md-4"><div class="metric-card pro-metric"><h6>Today Production Plan</h6><h3>1,950</h3><small>units</small></div></div>
            <div class="col-md-4"><div class="metric-card pro-metric"><h6>Quality Pass Rate</h6><h3>98.7%</h3><small>last 24h</small></div></div>
            <div class="col-md-4"><div class="metric-card pro-metric"><h6>Urgent Refill Requests</h6><h3>4</h3><small>from distributors</small></div></div>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="role-card">
                    <h4>Announcements</h4>
                    <ul class="news-list mb-0">
                        <li>Line B maintenance scheduled tonight 11:00 PM.</li>
                        <li>Winter wool batch dispatch starts tomorrow morning.</li>
                        <li>Raw material stock audit due by Friday.</li>
                    </ul>
                </div>
            </div>
            <div class="col-md-6">
                <div class="role-card">
                    <h4>Gallery</h4>
                    <div class="gallery-grid gallery-grid-image">
                        <img class="gallery-image" src="@Url.Content("~/Content/images/cotton.svg")" alt="Cotton floor" />
                        <img class="gallery-image" src="@Url.Content("~/Content/images/wooden.svg")" alt="Packing logistics" />
                        <img class="gallery-image" src="@Url.Content("~/Content/images/blankets.svg")" alt="Blanket quality dashboard" />
                    </div>
                </div>
            </div>
        </div>
    }
    else if (loggedInRole == "Distributor")
    {
        <section class="dashboard-head distributor-head dashboard-head-pro">
            <div>
                <p class="eyebrow">Distributor Home</p>
                <h1>Welcome, @loggedInUser</h1>
                <p class="text-muted mb-0">Warehouse and dispatch overview with route and refill alerts.</p>
            </div>
            <img class="dashboard-hero-image" src="@Url.Content("~/Content/images/wooden.svg")" alt="Wooden warehouse dashboard" />
        </section>

        <div class="row g-3 mb-3">
            <div class="col-md-4"><div class="metric-card pro-metric"><h6>Pending Dispatch</h6><h3>19</h3><small>seller orders</small></div></div>
            <div class="col-md-4"><div class="metric-card pro-metric"><h6>On-Time Shipments</h6><h3>92%</h3><small>this week</small></div></div>
            <div class="col-md-4"><div class="metric-card pro-metric"><h6>Low Stock SKUs</h6><h3>6</h3><small>needs refill</small></div></div>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="role-card">
                    <h4>Announcements</h4>
                    <ul class="news-list mb-0">
                        <li>Route C delayed by weather; ETA +6 hours.</li>
                        <li>New priority channel enabled for online sellers.</li>
                        <li>Monthly warehouse safety drill on Monday.</li>
                    </ul>
                </div>
            </div>
            <div class="col-md-6">
                <div class="role-card">
                    <h4>Gallery</h4>
                    <div class="gallery-grid gallery-grid-image">
                        <img class="gallery-image" src="@Url.Content("~/Content/images/wooden.svg")" alt="Wooden warehouse bay" />
                        <img class="gallery-image" src="@Url.Content("~/Content/images/cotton.svg")" alt="Cotton dispatch dock" />
                        <img class="gallery-image" src="@Url.Content("~/Content/images/blankets.svg")" alt="Blanket route console" />
                    </div>
                </div>
            </div>
        </div>
    }
    else if (loggedInRole == "Seller")
    {
        <section class="dashboard-head seller-head dashboard-head-pro">
            <div>
                <p class="eyebrow">Seller Home</p>
                <h1>Welcome, @loggedInUser</h1>
                <p class="text-muted mb-0">Storefront performance overview with customer and fulfillment highlights.</p>
            </div>
            <img class="dashboard-hero-image" src="@Url.Content("~/Content/images/blankets.svg")" alt="Seller blanket dashboard" />
        </section>

        <div class="row g-3 mb-3">
            <div class="col-md-4"><div class="metric-card pro-metric"><h6>Orders Today</h6><h3>33</h3><small>customer requests</small></div></div>
            <div class="col-md-4"><div class="metric-card pro-metric"><h6>Customer Rating</h6><h3>4.8/5</h3><small>this month</small></div></div>
            <div class="col-md-4"><div class="metric-card pro-metric"><h6>Backorder Items</h6><h3>7</h3><small>awaiting distributor</small></div></div>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="role-card">
                    <h4>Announcements</h4>
                    <ul class="news-list mb-0">
                        <li>Weekend promo starts Friday 6:00 PM.</li>
                        <li>Top-selling SKU: CC-WOOL-QUEEN.</li>
                        <li>Customer care webinar available in portal.</li>
                    </ul>
                </div>
            </div>
            <div class="col-md-6">
                <div class="role-card">
                    <h4>Gallery</h4>
                    <div class="gallery-grid gallery-grid-image">
                        <img class="gallery-image" src="@Url.Content("~/Content/images/blankets.svg")" alt="Blanket store display" />
                        <img class="gallery-image" src="@Url.Content("~/Content/images/wooden.svg")" alt="Wooden fulfillment desk" />
                        <img class="gallery-image" src="@Url.Content("~/Content/images/cotton.svg")" alt="Cotton catalog studio" />
                    </div>
                </div>
            </div>
        </div>
    }
    else if (loggedInRole == "Customer")
    {
        <section class="dashboard-head dashboard-head-pro">
            <div>
                <p class="eyebrow">Customer Home</p>
                <h1>Welcome, @loggedInUser</h1>
                <p class="text-muted mb-0">Track your order requests and confirmation updates from sellers.</p>
                <div class="hero-actions mt-3">
                    <a href="@Url.Action("Customer", "Home")" class="btn btn-primary">Open My Orders</a>
                </div>
            </div>
            <img class="dashboard-hero-image" src="@Url.Content("~/Content/images/wool.svg")" alt="Customer wool dashboard" />
        </section>
    }
    else if (loggedInRole == "Admin")
    {
        <section class="dashboard-head dashboard-head-pro">
            <div>
                <p class="eyebrow">Admin Home</p>
                <h1>Welcome, @loggedInUser</h1>
                <p class="text-muted mb-0">Use the admin panel to approve role signup requests and control access to dashboards.</p>
                <div class="hero-actions mt-3">
                    <a href="@Url.Action("Admin", "Home")" class="btn btn-primary">Open Admin Panel</a>
                </div>
            </div>
            <img class="dashboard-hero-image" src="@Url.Content("~/Content/images/blankets.svg")" alt="Admin blanket dashboard" />
        </section>
    }
</main>
