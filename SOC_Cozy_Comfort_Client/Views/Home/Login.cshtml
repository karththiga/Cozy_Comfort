@{
    ViewBag.Title = "Common Login";
}

<section class="auth-shell">
    <div class="auth-card auth-login-card">
        <div class="auth-brand-panel">
            <p class="eyebrow mb-2">Cozy Comfort</p>
            <h2>Warm supply chain.<br />Secure access.</h2>
            <p class="mb-0">Log in to manage blankets, requests, and notifications from one polished dashboard.</p>

            <div class="sample-credentials mt-4 mb-0">
                <p class="mb-2"><strong>Test Login Credentials</strong></p>
                <ul class="mb-0">
                    <li><strong>Manufacturer:</strong> <code>m_admin</code> / <code>M@123</code></li>
                    <li><strong>Distributor:</strong> <code>d_admin</code> / <code>D@123</code></li>
                    <li><strong>Seller:</strong> <code>s_admin</code> / <code>S@123</code></li>
                </ul>
            </div>
        </div>

        <div class="auth-form-panel">
            <h3 class="mb-2">Sign in</h3>
            <p class="text-muted mb-4">Use your account credentials to continue.</p>

            @if (TempData["AuthMessage"] != null)
            {
                <div class="alert alert-success">@TempData["AuthMessage"]</div>
            }

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
            }

            @using (Html.BeginForm("Login", "Home", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label">Username</label>
                    <input type="text" name="userName" class="form-control form-control-lg" placeholder="Enter username" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input type="password" name="password" class="form-control form-control-lg" placeholder="Enter password" required />
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100">Login to Dashboard</button>
            }

            <p class="auth-helper-text mt-4 mb-0">New to Cozy Comfort? <a href="@Url.Action("Signup", "Home")">Create a sign up request</a>.</p>
        </div>
    </div>
</section>
