@{
    ViewBag.Title = "Common Login";
}

<section class="login-wrap pro-login-section">
    <div class="login-card pro-login-card">
        <div class="login-header">
            <p class="eyebrow mb-1">Secure Access</p>
            <h2>Welcome to Cozy Comfort</h2>
            <p class="text-muted mb-0">Sign in once and choose your operational role.</p>
        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger mt-3">@ViewBag.ErrorMessage</div>
        }

        <div class="sample-credentials mt-3 mb-3">
            <p class="mb-2"><strong>Test Login Credentials</strong></p>
            <ul class="mb-0">
                <li><strong>Manufacturer:</strong> username <code>m_admin</code> / password <code>M@123</code></li>
                <li><strong>Distributor:</strong> username <code>d_admin</code> / password <code>D@123</code></li>
                <li><strong>Seller:</strong> username <code>s_admin</code> / password <code>S@123</code></li>
            </ul>
        </div>

        @using (Html.BeginForm("Login", "Home", FormMethod.Post, new { @class = "mt-4" }))
        {
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Username</label>
                <input type="text" name="userName" class="form-control form-control-lg" placeholder="Enter username" />
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password" name="password" class="form-control form-control-lg" placeholder="Enter password" />
            </div>

            <div class="mb-4">
                <label class="form-label">Login As</label>
                <select name="role" class="form-select form-select-lg">
                    <option value="">Select Role</option>
                    <option value="Manufacturer">Manufacturer Admin</option>
                    <option value="Distributor">Distributor Admin</option>
                    <option value="Seller">Seller Admin</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100">Login to Dashboard</button>
        }
    </div>
</section>
