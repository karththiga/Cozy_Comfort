@model SOC_Cozy_Comfort_Client.Models.InventoryItem
@{
    var role = ViewBag.Role as string;
    ViewBag.Title = "Edit Inventory";
    var isFixedRole = role == "Manufacturer" || role == "Distributor";
    var fixedLocation = string.IsNullOrWhiteSpace(Model.Location)
        ? (role == "Manufacturer" ? "Main Manufacturing Facility" : (role == "Distributor" ? "Distributor Hub" : string.Empty))
        : Model.Location;
    var locationValue = isFixedRole ? fixedLocation : Model.Location;
    var cancelUrl = Url.Action(role, "Home");
    var errorMessage = ViewBag.ErrorMessage as string;
    var errorStyle = string.IsNullOrWhiteSpace(errorMessage) ? "display:none;" : string.Empty;
    var fixedLocationStyle = isFixedRole ? string.Empty : "display:none;";
    var editableLocationStyle = isFixedRole ? "display:none;" : string.Empty;
}

<section class="dashboard-shell">
    <div class="role-card" style="max-width:700px;margin:0 auto;">
        <h2>Edit Inventory Item (@role)</h2>

        <div class="alert alert-danger" style="@errorStyle">@errorMessage</div>

        @using (Html.BeginForm("EditInventory", "Home", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="role" value="@role" />
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="mb-3"><label class="form-label">SKU</label><input name="Sku" class="form-control" value="@Model.Sku" required /></div>
            <div class="mb-3"><label class="form-label">Item Name</label><input name="Name" class="form-control" value="@Model.Name" required /></div>
            <div class="mb-3"><label class="form-label">Quantity</label><input type="number" min="0" name="Quantity" class="form-control" value="@Model.Quantity" /></div>

            <div class="mb-3" style="@fixedLocationStyle">
                <label class="form-label">Location</label>
                <input class="form-control" value="@locationValue" readonly="readonly" />
                <input type="hidden" name="Location" value="@locationValue" />
            </div>

            <div class="mb-3" style="@editableLocationStyle">
                <label class="form-label">Location</label>
                <input name="Location" class="form-control" value="@locationValue" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a class="btn btn-outline-secondary" href="@cancelUrl">Cancel</a>
            </div>
        }
    </div>
</section>
