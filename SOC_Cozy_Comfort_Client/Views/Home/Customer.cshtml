@model SOC_Cozy_Comfort_Client.Models.RequestBoardViewModel
@{
    ViewBag.Title = "Customer Dashboard";
}

<section class="request-page">
    <div class="dashboard-head dashboard-head-pro">
        <div>
            <p class="eyebrow">Customer Orders</p>
            <h1>Request blankets from sellers</h1>
            <p class="text-muted mb-0">Browse blanket catalog with images and details, place orders, and track status updates.</p>
        </div>
        <img class="dashboard-hero-image" src="@Url.Content("~/Content/images/rabbit-blanket.svg")" alt="Customer rabbit blanket ordering" />
    </div>

    @if (TempData["RequestMessage"] != null)
    {<div class="alert alert-success">@TempData["RequestMessage"]</div>}
    @if (TempData["RequestError"] != null)
    {<div class="alert alert-danger">@TempData["RequestError"]</div>}

    <div class="role-card mt-3">
        <h4 class="mb-3">Available Blankets from Seller</h4>
        <div class="table-responsive">
            <table class="table table-hover align-middle request-table">
                <thead><tr><th>Image</th><th>SKU</th><th>Name</th><th>Details</th><th>Available Qty</th><th>Order</th></tr></thead>
                <tbody>
                    @if (Model.SellerCatalogItems == null || Model.SellerCatalogItems.Count == 0)
                    {
                        <tr><td colspan="6" class="text-muted">No seller inventory available right now.</td></tr>
                    }
                    else
                    {
                        foreach (var item in Model.SellerCatalogItems)
                        {
                            var imgUrl = (Model.SellerCatalogImageUrls != null && Model.SellerCatalogImageUrls.ContainsKey(item.Sku))
                                ? Model.SellerCatalogImageUrls[item.Sku]
                                : Url.Content("~/Content/images/blankets.svg");

                            var details = (Model.SellerCatalogDetails != null && Model.SellerCatalogDetails.ContainsKey(item.Sku))
                                ? Model.SellerCatalogDetails[item.Sku]
                                : "Premium blanket from seller stock.";

                            <tr>
                                <td style="width:120px;">
                                    <img src="@imgUrl" alt="@item.Name blanket" style="width:96px;height:70px;object-fit:cover;border-radius:8px;border:1px solid #dee2e6;" />
                                </td>
                                <td>@item.Sku</td>
                                <td>@item.Name</td>
                                <td><small class="text-muted">@details</small></td>
                                <td>@item.Quantity</td>
                                <td>
                                    @using (Html.BeginForm("CreateCustomerOrder", "Home", FormMethod.Post, new { @class = "d-flex gap-2 align-items-center" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="Sku" value="@item.Sku" />
                                        <input type="hidden" name="BlanketName" value="@item.Name" />
                                        <input type="hidden" name="Notes" value="Placed from customer catalog." />
                                        <input type="number" name="Quantity" min="1" class="form-control form-control-sm" style="max-width:120px;" required @(item.Quantity <= 0 ? "disabled" : null) />
                                        <button type="submit" class="btn btn-sm btn-primary" @(item.Quantity <= 0 ? "disabled" : null)>Order</button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-md-4">
            <div class="role-card">
                <h4 class="mb-3">Manual Order (Custom SKU)</h4>
                @using (Html.BeginForm("CreateCustomerOrder", "Home", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="mb-2"><label class="form-label">SKU</label><input name="Sku" class="form-control" required /></div>
                    <div class="mb-2"><label class="form-label">Blanket Name</label><input name="BlanketName" class="form-control" required /></div>
                    <div class="mb-2"><label class="form-label">Quantity</label><input type="number" name="Quantity" min="1" class="form-control" required /></div>
                    <div class="mb-3"><label class="form-label">Notes</label><textarea name="Notes" class="form-control" rows="3" placeholder="Address / preference"></textarea></div>
                    <button type="submit" class="btn btn-primary w-100">Place Order Request</button>
                }
            </div>
        </div>

        <div class="col-md-8">
            <div class="role-card">
                <h4 class="mb-3">My Orders</h4>
                <table class="table table-hover align-middle request-table">
                    <thead><tr><th>ID</th><th>SKU</th><th>Name</th><th>Qty</th><th>Status</th><th>Updated</th></tr></thead>
                    <tbody>
                    @foreach (var req in Model.OutgoingRequests)
                    {
                        <tr>
                            <td>@req.Id</td>
                            <td>@req.Sku</td>
                            <td>@req.BlanketName</td>
                            <td>@req.Quantity</td>
                            <td><span class="status-pill">@req.Status</span></td>
                            <td>@req.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
