        <thead><tr><th>Order Id</th><th>Seller</th><th>Required Date</th><th>Status</th></tr></thead>
        <tbody>
            <tr><td>SO-2124</td><td>Urban Home Store</td><td>2026-02-13</td><td><span class="badge text-bg-primary">Packed</span></td></tr>
            <tr><td>SO-2125</td><td>DreamNest Online</td><td>2026-02-14</td><td><span class="badge text-bg-info">Ready for Route</span></td></tr>
            <tr><td>SO-2126</td><td>WarmLiving Mart</td><td>2026-02-15</td><td><span class="badge text-bg-warning">Awaiting Stock</span></td></tr>
        </tbody>
    </table>
</div>
