<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title - Cozy Comfort</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <header class="site-header sticky-top">
        <nav class="navbar navbar-expand-lg cozy-navbar">
            <div class="container">
                @Html.ActionLink("Cozy Comfort", "Index", "Home", new { area = "" }, new { @class = "navbar-brand fw-semibold" })
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="mainNav" class="collapse navbar-collapse justify-content-end">
                    <ul class="navbar-nav align-items-lg-center gap-lg-3">
                        <li class="nav-item">@Html.ActionLink("Home", "Index", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("API Docs", "Index", "Help", new { area = "" }, new { @class = "nav-link" })</li>
                        <li class="nav-item mt-2 mt-lg-0"><a class="btn btn-sm btn-cozy" href="#contact">Contact Us</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container body-content">
        @RenderBody()
    </main>

    <footer id="contact" class="site-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 py-4">
            <p class="mb-0">&copy; @DateTime.Now.Year Cozy Comfort. Crafted for calm and comfort.</p>
            <p class="mb-0 footer-note">support@cozycomfort.com</p>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
