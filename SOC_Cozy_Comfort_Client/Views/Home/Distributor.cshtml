@{
    ViewBag.Title = "Distributor Admin";
}

<h1>Distributor Admin Dashboard</h1>
<p class="text-muted">Welcome @(ViewBag.LoggedInUser ?? "Admin"). Monitor inventory and inter-service fulfillment.</p>

<div class="row g-3 mb-3">
    <div class="col-md-4"><div class="metric-card"><h6>Warehouse SKUs</h6><h3>61</h3></div></div>
    <div class="col-md-4"><div class="metric-card"><h6>Pending Seller Orders</h6><h3>19</h3></div></div>
    <div class="col-md-4"><div class="metric-card"><h6>Refill Requests</h6><h3>4</h3></div></div>
</div>

<div class="role-card">
    <h3>Dispatch Planning</h3>
