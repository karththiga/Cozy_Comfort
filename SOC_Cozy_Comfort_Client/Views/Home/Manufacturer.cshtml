@{
    ViewBag.Title = "Manufacturer Admin";
}

<section class="dashboard-shell">
    <div class="dashboard-head manufacturer-head">
        <div>
            <p class="eyebrow">Manufacturer Command</p>
            <h1>Manufacturer Admin Dashboard</h1>
            <p class="text-muted mb-0">Welcome @(ViewBag.LoggedInUser ?? "Admin"). Track production, stock, and fulfillment commitments.</p>
        </div>
    </div>

    <div class="row g-3 mt-1 mb-3">
        <div class="col-md-3"><div class="metric-card pro-metric"><h6>Total Models</h6><h3>24</h3><small>+2 this quarter</small></div></div>
        <div class="col-md-3"><div class="metric-card pro-metric"><h6>Daily Capacity</h6><h3>1,950</h3><small>units/day</small></div></div>
        <div class="col-md-3"><div class="metric-card pro-metric"><h6>Available Stock</h6><h3>5,420</h3><small>ready for dispatch</small></div></div>
        <div class="col-md-3"><div class="metric-card pro-metric"><h6>Utilization</h6><h3>74%</h3><small>healthy range</small></div></div>
    </div>

    <div class="role-card">
        <h3 class="mb-3">Production Queue Snapshot</h3>
        <table class="table table-striped table-hover align-middle">
            <thead><tr><th>Model</th><th>Material</th><th>Planned Units</th><th>Completion</th><th>Status</th></tr></thead>
            <tbody>
                <tr><td>CC-WOOL-QUEEN</td><td>Wool Blend</td><td>420</td><td>82%</td><td><span class="badge text-bg-success">On Track</span></td></tr>
                <tr><td>CC-COTTON-KING</td><td>Organic Cotton</td><td>280</td><td>61%</td><td><span class="badge text-bg-warning">At Risk</span></td></tr>
                <tr><td>CC-FLEECE-SINGLE</td><td>Micro Fleece</td><td>360</td><td>88%</td><td><span class="badge text-bg-success">On Track</span></td></tr>
            </tbody>
        </table>
    </div>
</section>
