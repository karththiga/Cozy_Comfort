@{
    ViewBag.Title = "Distributor Admin";
}

<section class="dashboard-shell">
    <div class="dashboard-head distributor-head">
        <div>
            <p class="eyebrow">Distributor Command</p>
            <h1>Distributor Admin Dashboard</h1>
            <p class="text-muted mb-0">Welcome @(ViewBag.LoggedInUser ?? "Admin"). Manage inventory velocity, dispatch, and manufacturer refills.</p>
        </div>
    </div>

    <div class="row g-3 mt-1 mb-3">
        <div class="col-md-3"><div class="metric-card pro-metric"><h6>Warehouse SKUs</h6><h3>61</h3><small>active items</small></div></div>
        <div class="col-md-3"><div class="metric-card pro-metric"><h6>Pending Orders</h6><h3>19</h3><small>seller requests</small></div></div>
        <div class="col-md-3"><div class="metric-card pro-metric"><h6>Refill Requests</h6><h3>4</h3><small>awaiting manufacturer</small></div></div>
        <div class="col-md-3"><div class="metric-card pro-metric"><h6>Dispatch SLA</h6><h3>92%</h3><small>within target</small></div></div>
    </div>

    <div class="role-card">
        <h3 class="mb-3">Dispatch Planning Board</h3>
        <table class="table table-bordered table-hover align-middle">
            <thead><tr><th>Order Id</th><th>Seller</th><th>Required Date</th><th>Priority</th><th>Status</th></tr></thead>
            <tbody>
                <tr><td>SO-2124</td><td>Urban Home Store</td><td>2026-02-13</td><td>High</td><td><span class="badge text-bg-primary">Packed</span></td></tr>
                <tr><td>SO-2125</td><td>DreamNest Online</td><td>2026-02-14</td><td>Medium</td><td><span class="badge text-bg-info">Ready for Route</span></td></tr>
                <tr><td>SO-2126</td><td>WarmLiving Mart</td><td>2026-02-15</td><td>High</td><td><span class="badge text-bg-warning">Awaiting Stock</span></td></tr>
            </tbody>
        </table>
    </div>
</section>
