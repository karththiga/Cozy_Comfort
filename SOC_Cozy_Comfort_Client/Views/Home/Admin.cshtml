@model SOC_Cozy_Comfort_Client.Models.AdminDashboardViewModel
@{
    ViewBag.Title = "Admin Panel";
}

<section class="dashboard-shell">
    <div class="dashboard-head dashboard-head-pro mb-3">
        <div>
            <p class="eyebrow">Access Control</p>
            <h2>Admin user management</h2>
            <p class="text-muted mb-0">Approve pending signup requests to enable Manufacturer, Distributor, and Seller dashboards.</p>
        </div>
        <img class="dashboard-hero-image" src="https://m.media-amazon.com/images/I/81mjb6Cmt0L._AC_SL1500_.jpg" alt="Admin blanket operations" />
    </div>

    @if (TempData["AuthMessage"] != null)
    {
        <div class="alert alert-success">@TempData["AuthMessage"]</div>
    }

    @if (TempData["InventoryError"] != null)
    {
        <div class="alert alert-danger">@TempData["InventoryError"]</div>
    }

    <div class="role-card">
        <h4>Create Manufacturer / Distributor</h4>
        <p class="text-muted">Only admin can create distributor accounts and a single manufacturer account.</p>

        @using (Html.BeginForm("AdminCreateUser", "Home", FormMethod.Post, new { @class = "row g-3 mb-4" }))
        {
            @Html.AntiForgeryToken()

            <div class="col-md-4">
                <label class="form-label">Full Name</label>
                <input type="text" name="fullName" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Email</label>
                <input type="email" name="email" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Username</label>
                <input type="text" name="userName" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Role</label>
                <select name="role" class="form-select" required>
                    <option value="">Choose role</option>
                    <option value="Manufacturer">Manufacturer</option>
                    <option value="Distributor">Distributor</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Password</label>
                <input type="password" name="password" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Confirm Password</label>
                <input type="password" name="confirmPassword" class="form-control" required />
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">Create User</button>
            </div>
        }

    </div>


    <div class="role-card mt-3">
        <h4>All users</h4>

        @if (Model.Users == null || Model.Users.Count == 0)
        {
            <p class="text-muted mb-0">No users found.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Username</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>@user.Id</td>
                                <td>@user.FullName</td>
                                <td>@user.Email</td>
                                <td>@user.UserName</td>
                                <td>@user.RoleName</td>
                                <td>@(user.IsApproved ? "Approved" : "Pending")</td>
                                <td>
                                    @if (string.Equals(user.RoleName, "Admin", System.StringComparison.OrdinalIgnoreCase) || string.Equals(user.UserName, Model.LoggedInUser, System.StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="text-muted">Protected</span>
                                    }
                                    else
                                    {
                                        using (Html.BeginForm("DeleteUser", "Home", FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this user? This action cannot be undone.');">Delete</button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>


    <div class="role-card mt-3">
        <h4>Pending signup requests</h4>

        @if (Model.PendingUsers == null || Model.PendingUsers.Count == 0)
        {
            <p class="text-muted mb-0">No pending users right now.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Username</th>
                            <th>Requested Role</th>
                            <th>Assigned Distributor</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.PendingUsers)
                        {
                            <tr>
                                <td>@user.Id</td>
                                <td>@user.FullName</td>
                                <td>@user.Email</td>
                                <td>@user.UserName</td>
                                <td>@user.RequestedRole</td>
                                <td>@(string.IsNullOrWhiteSpace(user.AssignedDistributor) ? "-" : user.AssignedDistributor)</td>
                                <td>
                                    @using (Html.BeginForm("ApproveUser", "Home", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
