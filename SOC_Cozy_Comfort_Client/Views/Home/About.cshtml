@{
    ViewBag.Title = "About";
}

<main aria-labelledby="title">
    <section class="dashboard-head dashboard-head-pro mb-3">
        <div>
            <p class="eyebrow">Platform Overview</p>
            <h2 id="title">SOC Assignment Scope</h2>
            <p class="text-muted mb-0">@ViewBag.Message</p>
        </div>
        <img class="dashboard-hero-image" src="@Url.Content("~/Content/images/premium-blanket.svg")" alt="Cozy Comfort blanket operations overview" />
    </section>

    <div class="role-card">
        <h3>Planned Service Boundaries</h3>
        <ul>
            <li><strong>Manufacturer API:</strong> products, material metadata, stock, production slots.</li>
            <li><strong>Distributor API:</strong> inventory, allocation, logistics milestones, refill requests.</li>
            <li><strong>Seller API:</strong> customer orders, order status, stock reservation and notifications.</li>
            <li><strong>Order Orchestration:</strong> request tracking and lead-time decisions across all parties.</li>
        </ul>
    </div>
</main>
