<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Cozy Comfort SOC Portal</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:FILL@0;1&display=swap" rel="stylesheet">
</head>
<body class="cc-body-bg">
    @{
        var loggedInRole = Session["LoggedInRole"] as string;
        var loggedInUser = Session["LoggedInUser"] as string;
    }

    <nav class="navbar navbar-expand-sm navbar-dark cc-topbar sticky-top">
        <div class="container-fluid px-3 px-lg-4">
            @Html.ActionLink("Cozy Comfort", "Index", "Home", new { area = "" }, new { @class = "navbar-brand fw-bold" })
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1 cc-nav-list">
                    @if (string.IsNullOrWhiteSpace(loggedInRole))
                    {
                        <li>@Html.ActionLink("Login", "Login", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    }
                    else if (loggedInRole == "Manufacturer")
                    {
                        <li>@Html.ActionLink("Inventory", "Manufacturer", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                        <li>@Html.ActionLink("Manufacturer Requests", "ManufacturerRequests", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    }
                    else if (loggedInRole == "Distributor")
                    {
                        <li>@Html.ActionLink("Inventory", "Distributor", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                        <li>@Html.ActionLink("Distributor Requests", "DistributorRequests", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    }
                    else if (loggedInRole == "Seller")
                    {
                        <li>@Html.ActionLink("Inventory", "Seller", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                        <li>@Html.ActionLink("Seller Requests", "SellerRequests", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    }
                    else if (loggedInRole == "Admin")
                    {
                        <li>@Html.ActionLink("Admin Panel", "Admin", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    }
                    else if (loggedInRole == "Customer")
                    {
                        <li>@Html.ActionLink("My Orders", "Customer", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    }

                </ul>

                @if (!string.IsNullOrWhiteSpace(loggedInRole))
                {
                    <ul class="navbar-nav align-items-sm-center gap-sm-2">
                        <li class="nav-item">
                            <a class="nav-link notification-icon-link" href="@Url.Action("Notifications", "Home")" title="Notifications" aria-label="Notifications">
                                <span class="material-symbols-rounded" aria-hidden="true">notifications</span>
                            </a>
                        </li>
                        <li class="nav-item"><span class="nav-link disabled">@loggedInUser (@loggedInRole)</span></li>
                        <li class="nav-item">@Html.ActionLink("Logout", "Logout", "Home", new { area = "" }, new { @class = "btn btn-outline-light btn-sm ms-sm-2" })</li>
                    </ul>
                }
            </div>
        </div>
    </nav>

    <div class="container-fluid body-content px-3 px-lg-4">
        @RenderBody()
        <hr />
        <footer class="cc-footer">
            <p>&copy; @DateTime.Now.Year - Cozy Comfort SOC Assignment Portal</p>
        </footer>
    </div>

    <div id="apiLoader" class="api-loader-overlay" aria-hidden="true">
        <div class="api-loader-card">
            <div class="api-spinner" role="status" aria-label="Loading"></div>
            <p class="mb-0 mt-2">Processing request... Please wait while data is saved.</p>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script>
        (function () {
            var loader = document.getElementById('apiLoader');
            if (!loader) return;

            function showLoader() {
                loader.classList.add('show');
                loader.setAttribute('aria-hidden', 'false');
            }

            var forms = document.querySelectorAll('form');
            forms.forEach(function (form) {
                form.addEventListener('submit', function () {
                    showLoader();
                    var buttons = form.querySelectorAll('button[type="submit"], input[type="submit"]');
                    buttons.forEach(function (btn) { btn.disabled = true; });
                });
            });
        })();
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
