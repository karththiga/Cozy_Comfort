@{
    ViewBag.Title = "Customer Sign Up";
}

<section class="auth-shell">
    <div class="auth-card auth-signup-card">
        <div class="auth-form-panel auth-form-panel-wide">
            <p class="eyebrow mb-2">Customer Access</p>
            <h3 class="mb-2">Create customer account</h3>
            <p class="text-muted mb-4">Customer signup is separate from operational staff roles.</p>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
            }

            @using (Html.BeginForm("CustomerSignup", "Home", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Full Name</label>
                        <input type="text" name="fullName" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Username</label>
                        <input type="text" name="userName" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Password</label>
                        <input type="password" name="password" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Confirm Password</label>
                        <input type="password" name="confirmPassword" class="form-control" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary mt-4">Create Customer Account</button>
                <a class="btn btn-link mt-4" href="@Url.Action("Login", "Home")">Back to login</a>
            }
        </div>
    </div>
</section>
