@model SOC_Cozy_Comfort_Client.Models.RequestBoardViewModel
@using System.Linq
@{
    ViewBag.Title = "Seller Requests";

    var outgoingRequests = Model.OutgoingRequests ?? new System.Collections.Generic.List<SOC_Cozy_Comfort_Client.Models.OrderRequestItem>();
    var activeSellerRequests = outgoingRequests
        .Where(r => !string.IsNullOrWhiteSpace(r.Status)
                    && !r.Status.Contains("Cancelled")
                    && !r.Status.Contains("Fulfilled"))
        .OrderByDescending(r => r.UpdatedAt)
        .ToList();

    var fulfilledSellerRequests = outgoingRequests
        .Where(r => !string.IsNullOrWhiteSpace(r.Status) && r.Status.Contains("Fulfilled"))
        .OrderByDescending(r => r.UpdatedAt)
        .ToList();

    var cancelledSellerRequests = outgoingRequests
        .Where(r => !string.IsNullOrWhiteSpace(r.Status) && r.Status.Contains("Cancelled"))
        .OrderByDescending(r => r.UpdatedAt)
        .ToList();
}

<section class="request-page">
    <div class="dashboard-head seller-head dashboard-head-pro">
        <div>
        <p class="eyebrow">Seller Workflow</p>
        <h1>Request Blankets from Distributor</h1>
        <p class="text-muted mb-0">Create request when seller inventory is not enough. Distributor will receive it immediately.</p>
        </div>
        <img class="dashboard-hero-image" src="@Url.Content("~/Content/images/blankets.svg")" alt="Seller workflow operations" />
    </div>

    @if (TempData["RequestMessage"] != null)
    {<div class="alert alert-success">@TempData["RequestMessage"]</div>}
    @if (TempData["RequestError"] != null)
    {<div class="alert alert-danger">@TempData["RequestError"]</div>}


    <div class="role-card mt-3" id="incomingCustomerOrdersCard">
        <h4 class="mb-3">Incoming Customer Orders</h4>
        <p class="text-muted">Process order: if stock exists it confirms immediately, otherwise it auto-requests distributor.</p>
        <table class="table table-hover align-middle request-table">
            <thead><tr><th>ID</th><th>Customer</th><th>SKU</th><th>Name</th><th>Qty</th><th>Status</th><th>Action</th></tr></thead>
            <tbody>
            @foreach (var req in Model.IncomingRequests)
            {
                if (req.RequestedByRole == "Customer")
                {
                    <tr>
                        <td>@req.Id</td>
                        <td>@req.RequestedByUser</td>
                        <td>@req.Sku</td>
                        <td>@req.BlanketName</td>
                        <td>@req.Quantity</td>
                        <td><span class="status-pill">@req.Status</span></td>
                        <td>
                            @if (req.Status == "PendingSellerConfirmation" || req.Status == "RequestedFromDistributor")
                            {
                                using (Html.BeginForm("SellerConfirmCustomerOrder", "Home", FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="requestId" value="@req.Id" />
                                    <input type="hidden" name="notes" value="Dispatched to customer by seller." />
                                    <button class="btn btn-sm btn-success" type="submit">Send to Customer</button>
                                }
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-md-4">
            <div class="role-card">
                <h4 class="mb-3">New Seller Request</h4>
                @using (Html.BeginForm("CreateSellerRequest", "Home", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="mb-2"><label class="form-label">SKU</label><input name="Sku" class="form-control" required /></div>
                    <div class="mb-2"><label class="form-label">Blanket Name</label><input name="BlanketName" class="form-control" required /></div>
                    <div class="mb-2"><label class="form-label">Quantity Needed</label><input type="number" name="Quantity" min="1" class="form-control" required /></div>
                    <div class="mb-3"><label class="form-label">Notes</label><textarea name="Notes" class="form-control" rows="3"></textarea></div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100" onclick="return confirm('Send this request to distributor?');">Send Request</button>
                        <a href="@Url.Action("Seller", "Home")" class="btn btn-outline-secondary w-100">Cancel</a>
                    </div>
                }
            </div>
        </div>
        <div class="col-md-8">
            <div class="role-card">
                <h4 class="mb-3">My Requests to Distributor (Active)</h4>
                <table class="table table-hover align-middle request-table">
                    <thead><tr><th>ID</th><th>SKU</th><th>Name</th><th>Qty</th><th>Status</th><th>Updated</th><th>Action</th></tr></thead>
                    <tbody>
                    @if (activeSellerRequests.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-muted">No active requests.</td>
                        </tr>
                    }

                    @foreach (var req in activeSellerRequests)
                    {
                        <tr>
                            <td>@req.Id</td>
                            <td>@req.Sku</td>
                            <td>@req.BlanketName</td>
                            <td>@req.Quantity</td>
                            <td><span class="status-pill">@req.Status</span></td>
                            <td>@req.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(req.Status) || !req.Status.Contains("Cancelled"))
                                {
                                    using (Html.BeginForm("SellerCancelRequest", "Home", FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="requestId" value="@req.Id" />
                                        <input type="hidden" name="notes" value="Cancelled by seller." />
                                        <button class="btn btn-sm btn-outline-secondary" type="submit" onclick="return confirm('Cancel this request?');">Cancel</button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div class="role-card mt-3">
                <h4 class="mb-3">Fulfilled / Stock Received</h4>
                <table class="table table-hover align-middle request-table">
                    <thead><tr><th>ID</th><th>SKU</th><th>Name</th><th>Qty</th><th>Status</th><th>Updated</th></tr></thead>
                    <tbody>
                    @if (fulfilledSellerRequests.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-muted">No fulfilled requests yet.</td>
                        </tr>
                    }

                    @foreach (var req in fulfilledSellerRequests)
                    {
                        <tr>
                            <td>@req.Id</td>
                            <td>@req.Sku</td>
                            <td>@req.BlanketName</td>
                            <td>@req.Quantity</td>
                            <td><span class="status-pill">@req.Status</span></td>
                            <td>@req.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div class="role-card mt-3">
                <h4 class="mb-3">Cancellation History</h4>
                <table class="table table-hover align-middle request-table">
                    <thead><tr><th>ID</th><th>SKU</th><th>Name</th><th>Qty</th><th>Status</th><th>Updated</th></tr></thead>
                    <tbody>
                    @if (cancelledSellerRequests.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-muted">No cancelled requests in history.</td>
                        </tr>
                    }

                    @foreach (var req in cancelledSellerRequests)
                    {
                        <tr>
                            <td>@req.Id</td>
                            <td>@req.Sku</td>
                            <td>@req.BlanketName</td>
                            <td>@req.Quantity</td>
                            <td><span class="status-pill">@req.Status</span></td>
                            <td>@req.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@section scripts {
    <script>
        (function () {
            var cards = Array.prototype.slice.call(document.querySelectorAll('.role-card'));
            var incomingCards = cards.filter(function (card) {
                var heading = card.querySelector('h4');
                return heading && heading.textContent && heading.textContent.trim() === 'Incoming Customer Orders';
            });

            if (incomingCards.length > 1) {
                for (var i = 0; i < incomingCards.length - 1; i++) {
                    incomingCards[i].remove();
                }
            }
        })();
    </script>
}
