@{
    ViewBag.Title = "SOC Dashboard";
}

<main>
    <section class="hero-card" aria-labelledby="dashboardTitle">
        <h1 id="dashboardTitle">Cozy Comfort Service-Oriented Commerce Portal</h1>
        <p class="lead">This starter UI organizes Manufacturer, Distributor, and Seller workflows into service-ready modules that can be connected to your .NET APIs.</p>
        <div class="hero-actions">
            <a href="@Url.Action("Orders", "Home")" class="btn btn-primary">Open Order Flow</a>
            <a href="@Url.Action("About", "Home")" class="btn btn-outline-dark">View SOC Scope</a>
        </div>
    </section>

    <section class="row g-3 mt-1">
        <div class="col-md-4">
            <article class="role-card">
                <h2>Manufacturer Service</h2>
                <p>Manage blanket catalog, production capacity, and stock availability APIs.</p>
                <a href="@Url.Action("Manufacturer", "Home")" class="btn btn-sm btn-outline-primary">Open screen</a>
            </article>
        </div>
        <div class="col-md-4">
            <article class="role-card">
                <h2>Distributor Service</h2>
                <p>Track intermediary inventory, logistics, and seller order orchestration.</p>
                <a href="@Url.Action("Distributor", "Home")" class="btn btn-sm btn-outline-primary">Open screen</a>
            </article>
        </div>
        <div class="col-md-4">
            <article class="role-card">
                <h2>Seller Service</h2>
                <p>Capture customer requests, reserve local stock, and trigger distributor fulfillment.</p>
                <a href="@Url.Action("Seller", "Home")" class="btn btn-sm btn-outline-primary">Open screen</a>
            </article>
        </div>
    </section>
</main>
