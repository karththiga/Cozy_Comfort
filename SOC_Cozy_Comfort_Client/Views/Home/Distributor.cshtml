@using System.Linq
@model SOC_Cozy_Comfort_Client.Models.RoleDashboardViewModel
@{
    ViewBag.Title = "Distributor Admin";
    var totalSkus = Model.Items.Count;
    var totalUnits = Model.Items.Sum(x => x.Quantity);
    var lowStockCount = Model.Items.Count(x => x.Quantity <= 20);
    var lastUpdated = Model.Items.Any() ? Model.Items.Max(x => x.LastUpdated).ToString("yyyy-MM-dd HH:mm") : "N/A";
}

<section class="dashboard-shell">
    <div class="dashboard-head distributor-head dashboard-head-pro">
        <div>
            <p class="eyebrow">Distributor Command</p>
            <h1>Distributor Admin Dashboard</h1>
            <p class="text-muted mb-0">Welcome @Model.LoggedInUser. Coordinate stock, dispatch, and upstream requests from one console.</p>
            <div class="mt-3">
                <a class="btn btn-primary" href="@Url.Action("DistributorRequests", "Home")">Review seller requests / request manufacturer</a>
            </div>
        </div>
        <img class="dashboard-hero-image" src="@Url.Content("~/Content/images/warehouse.svg")" alt="Distribution warehouse" />
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-3"><div class="metric-card pro-metric"><h6>Total SKUs</h6><h3>@totalSkus</h3><small>active records</small></div></div>
        <div class="col-md-3"><div class="metric-card pro-metric"><h6>Total Units</h6><h3>@totalUnits</h3><small>available quantity</small></div></div>
        <div class="col-md-3"><div class="metric-card pro-metric"><h6>Low Stock Items</h6><h3>@lowStockCount</h3><small>quantity ≤ 20</small></div></div>
        <div class="col-md-3"><div class="metric-card pro-metric"><h6>Last Updated</h6><h3 class="summary-time">@lastUpdated</h3><small>latest change</small></div></div>
    </div>

    @if (TempData["InventoryMessage"] != null)
    {<div class="alert alert-success">@TempData["InventoryMessage"]</div>}
    @if (TempData["InventoryError"] != null)
    {<div class="alert alert-danger">@TempData["InventoryError"]</div>}

    <div class="row g-3 mb-4">
        <div class="col-md-8">
            <div class="role-card">
                <h3 class="mb-3">Inventory List</h3>
                <table class="table table-hover align-middle">
                    <thead><tr><th>SKU</th><th>Name</th><th>Qty</th><th>Location</th><th>Updated</th><th>Actions</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Sku</td><td>@item.Name</td><td>@item.Quantity</td><td>@item.Location</td><td>@item.LastUpdated.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("EditInventory", "Home", new { role = Model.Role, id = item.Id })">Edit</a>
                                @using (Html.BeginForm("DeleteInventory", "Home", FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="role" value="@Model.Role" />
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this item?');">Delete</button>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col-md-4">
            <div class="role-card">
                <h3 class="mb-3">Add Inventory Item</h3>
                @using (Html.BeginForm("AddInventory", "Home", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="role" value="@Model.Role" />
                    <div class="mb-2"><label class="form-label">SKU</label><input name="newItem.Sku" class="form-control" required /></div>
                    <div class="mb-2"><label class="form-label">Item Name</label><input name="newItem.Name" class="form-control" required /></div>
                    <div class="mb-2"><label class="form-label">Quantity</label><input type="number" min="0" name="newItem.Quantity" class="form-control" /></div>
                    <div class="mb-3"><label class="form-label">Location</label><input name="newItem.Location" class="form-control" /></div>
                    <button type="submit" class="btn btn-primary w-100">Create</button>
                }
            </div>
        </div>
    </div>
</section>
