@{
    ViewBag.Title = "Welcome";
}

<main>
    <section class="hero-card" aria-labelledby="welcomeTitle">
        <h1 id="welcomeTitle">Cozy Comfort SOC Assignment Portal</h1>
        <p class="lead">Common login first, then role-based admin dashboards for Manufacturer, Distributor, and Seller operations.</p>
        <div class="hero-actions">
            <a href="@Url.Action("Login", "Home")" class="btn btn-primary">Go to Common Login</a>
            <a href="@Url.Action("Orders", "Home")" class="btn btn-outline-dark">View SOC Order Flow</a>
        </div>
    </section>

    <section class="row g-3 mt-2">
        <div class="col-md-4">
            <article class="role-card">
                <h3>Manufacturer Admin Dashboard</h3>
                <p>Track production capacity, model catalog status, and stock readiness.</p>
            </article>
        </div>
        <div class="col-md-4">
            <article class="role-card">
                <h3>Distributor Admin Dashboard</h3>
                <p>Monitor warehouse inventory, logistics schedules, and refill requests.</p>
            </article>
        </div>
        <div class="col-md-4">
            <article class="role-card">
                <h3>Seller Admin Dashboard</h3>
                <p>Manage customer orders, local stock, and distributor escalations.</p>
            </article>
        </div>
    </section>
</main>
