@{
    ViewBag.Title = "Sign Up";
    ViewBag.PageClass = "signup-photo-page";
    var distributors = ViewBag.Distributors as System.Collections.Generic.List<SOC_Cozy_Comfort_Client.Models.DistributorOptionItem>;
}

<section class="auth-shell auth-shell-blue auth-shell-photo">
    <div class="auth-card auth-signup-card">
        <div class="auth-form-panel auth-form-panel-wide">
            <p class="eyebrow mb-2">Create Staff Access</p>
            <h3 class="mb-2">Staff sign up request</h3>
            <p class="text-muted mb-4">Seller self-signup is available. Choose the distributor you report to and submit for admin approval.</p>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
            }

            @using (Html.BeginForm("Signup", "Home", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Full Name</label>
                        <input type="text" name="fullName" class="form-control" placeholder="Jane Doe" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" class="form-control" placeholder="name@company.com" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Username</label>
                        <input type="text" name="userName" class="form-control" placeholder="jane_admin" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Distributor</label>
                        <select name="distributorUserId" class="form-select" required>
                            <option value="">Choose distributor</option>
                            @if (distributors != null)
                            {
                                foreach (var distributor in distributors)
                                {
                                    <option value="@distributor.Id">@distributor.DisplayName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Seller Location</label>
                        <input type="text" name="sellerLocation" class="form-control" placeholder="City / Store location" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Password</label>
                        <input type="password" name="password" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Confirm Password</label>
                        <input type="password" name="confirmPassword" class="form-control" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary mt-4">Submit Sign Up Request</button>
                <a class="btn btn-link mt-4" href="@Url.Action("Login", "Home")">Back to login</a>
            }
        </div>
    </div>
</section>
