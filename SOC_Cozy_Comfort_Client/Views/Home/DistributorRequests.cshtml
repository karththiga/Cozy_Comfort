@model SOC_Cozy_Comfort_Client.Models.RequestBoardViewModel
@using System.Linq
@{
    ViewBag.Title = "Distributor Requests";
    var incomingRequests = Model.IncomingRequests ?? new System.Collections.Generic.List<SOC_Cozy_Comfort_Client.Models.OrderRequestItem>();
    var outgoingRequests = Model.OutgoingRequests ?? new System.Collections.Generic.List<SOC_Cozy_Comfort_Client.Models.OrderRequestItem>();

    var activeIncomingRequests = incomingRequests
        .Where(r => !string.IsNullOrWhiteSpace(r.Status)
                    && !r.Status.Contains("Cancelled")
                    && !r.Status.Contains("Fulfilled"))
        .ToList();

    var fulfilledOrReadyRequests = incomingRequests
        .Where(r => !string.IsNullOrWhiteSpace(r.Status) && r.Status.Contains("Fulfilled"))
        .Concat(outgoingRequests.Where(r => string.Equals(r.Status, "DispatchedByManufacturer")))
        .OrderByDescending(r => r.UpdatedAt)
        .ToList();

    var cancelledHistoryRequests = incomingRequests
        .Where(r => !string.IsNullOrWhiteSpace(r.Status) && r.Status.Contains("Cancelled"))
        .Concat(outgoingRequests.Where(r => !string.IsNullOrWhiteSpace(r.Status) && r.Status.Contains("Cancelled")))
        .OrderByDescending(r => r.UpdatedAt)
        .ToList();
}

<section class="request-page">
    <div class="dashboard-head distributor-head dashboard-head-pro">
        <div>
        <p class="eyebrow">Distributor Workflow</p>
        <h1>Seller Requests Received</h1>
        <p class="text-muted mb-0">Fulfill seller requests from distributor inventory or escalate to manufacturer.</p>
        </div>
        <img class="dashboard-hero-image" src="@Url.Content("~/Content/images/warehouse.svg")" alt="Distributor workflow operations" />
    </div>

    @if (TempData["RequestMessage"] != null)
    {<div class="alert alert-success">@TempData["RequestMessage"]</div>}
    @if (TempData["RequestError"] != null)
    {<div class="alert alert-danger">@TempData["RequestError"]</div>}

    <div class="role-card mt-3">
        <h4 class="mb-3">Incoming from Sellers (Active)</h4>
        <table class="table table-hover align-middle request-table">
            <thead><tr><th>ID</th><th>Seller</th><th>SKU</th><th>Qty</th><th>Status</th><th>Action</th></tr></thead>
            <tbody>
            @if (activeIncomingRequests.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-muted">No active seller requests.</td>
                </tr>
            }

            @foreach (var req in activeIncomingRequests)
            {
                <tr>
                    <td>@req.Id</td>
                    <td>@req.RequestedByUser</td>
                    <td>@req.Sku</td>
                    <td>@req.Quantity</td>
                    <td><span class="status-pill">@req.Status</span></td>
                    <td>
                        @if (string.Equals(req.Status, "PendingDistributorReview"))
                        {
                            using (Html.BeginForm("DistributorFulfill", "Home", FormMethod.Post, new { @class = "d-inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="requestId" value="@req.Id" />
                                <input type="hidden" name="notes" value="Fulfilled from distributor stock and moved to seller inventory." />
                                <button class="btn btn-sm btn-outline-success" type="submit" onclick="return confirm('Mark this as fulfilled by distributor?');">Fulfill &amp; Transfer</button>
                            }
                            using (Html.BeginForm("DistributorEscalate", "Home", FormMethod.Post, new { @class = "d-inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="requestId" value="@req.Id" />
                                <input type="hidden" name="notes" value="Escalated to manufacturer due to low stock." />
                                <button class="btn btn-sm btn-outline-primary" type="submit" onclick="return confirm('Escalate this request to manufacturer?');">Request Manufacturer</button>
                            }
                            using (Html.BeginForm("DistributorCancelRequest", "Home", FormMethod.Post, new { @class = "d-inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="requestId" value="@req.Id" />
                                <input type="hidden" name="notes" value="Cancelled by distributor." />
                                <button class="btn btn-sm btn-outline-secondary" type="submit" onclick="return confirm('Cancel this request?');">Cancel</button>
                            }
                        }
                        else
                        {
                            <span class="text-muted">No action</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="role-card mt-3">
        <h4 class="mb-3">Fulfilled / Ready to Deliver</h4>
        <table class="table table-hover align-middle request-table">
            <thead><tr><th>ID</th><th>From</th><th>SKU</th><th>Qty</th><th>Status</th><th>Updated</th></tr></thead>
            <tbody>
            @if (fulfilledOrReadyRequests.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-muted">No fulfilled or ready-to-deliver requests.</td>
                </tr>
            }

            @foreach (var req in fulfilledOrReadyRequests)
            {
                <tr>
                    <td>@req.Id</td>
                    <td>@(string.IsNullOrWhiteSpace(req.RequestedByRole) ? "-" : req.RequestedByRole)</td>
                    <td>@req.Sku</td>
                    <td>@req.Quantity</td>
                    <td><span class="status-pill">@req.Status</span></td>
                    <td>@req.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="role-card mt-3">
        <h4 class="mb-3">Cancellation History</h4>
        <table class="table table-hover align-middle request-table">
            <thead><tr><th>ID</th><th>From</th><th>SKU</th><th>Qty</th><th>Status</th><th>Updated</th></tr></thead>
            <tbody>
            @if (cancelledHistoryRequests.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-muted">No cancelled requests in history.</td>
                </tr>
            }

            @foreach (var req in cancelledHistoryRequests)
            {
                <tr>
                    <td>@req.Id</td>
                    <td>@(string.IsNullOrWhiteSpace(req.RequestedByRole) ? "-" : req.RequestedByRole)</td>
                    <td>@req.Sku</td>
                    <td>@req.Quantity</td>
                    <td><span class="status-pill">@req.Status</span></td>
                    <td>@req.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
